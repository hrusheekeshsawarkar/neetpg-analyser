# Copy to .env and fill in at least one key (never commit .env)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
BHT_LLM_KEY=

# Exclusive provider when set (openai | openrouter | bht)
LLM_PROVIDER=bht

# --- Product sync (analysis/sync/*) ---
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional model overrides
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENAI_MODEL=gpt-5.6-luna
# BHT_MODEL=bht/large

# Free OpenRouter models (text/JSON — streamed for reasoning models):
#   nvidia/nemotron-3-ultra-550b-a55b:free               ← primary text fallback
#   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free   ← OCR + JSON
#   google/gemma-4-26b-a4b-it:free                      ← often 429
#   google/gemma-4-31b-it:free
#   dots-studio/dots-3-note-preview:free
# NOTE: nvidia/nemotron-3-nano-omni:free does NOT exist (use full id above)
