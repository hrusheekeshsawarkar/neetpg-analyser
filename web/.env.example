# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (similar-search embeddings when using live Supabase)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# Optional: absolute path to web_mirror questions.json for local hybrid fallback
# QUESTIONS_MIRROR_PATH=

# Optional: CDN / Blob / Storage origin for question figures (no trailing slash).
# When unset, images load from /question_images/* in public/.
# NEXT_PUBLIC_QUESTION_IMAGES_BASE_URL=

# Set to 1 to allow local similar-search without auth (dev only)
# ALLOW_LOCAL_EXPLORE=1
